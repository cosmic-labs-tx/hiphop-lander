---
import Container from "@components/container.astro";
import Link from "@components/ui/link.astro";
import { Config } from "config";

type Props = {
  highlighted: string;
  title: string;
  subtitle: string;
  ctaText: string;
};

const props = Astro.props;
---

<Container>
  <div class="flex flex-col items-center">
    <h1
      class="text-center text-5xl font-bold text-balance md:text-7xl lg:text-8xl lg:tracking-tight xl:text-7xl xl:tracking-tighter"
    >
      <span class="text-brand-yellow block">{props.highlighted}</span>
      <span> {props.title}</span>
    </h1>
    <p class="mt-8 text-center text-lg font-medium">
      {props.subtitle}
    </p>
    <div class="mt-12 w-full sm:w-auto">
      <Link href={Config.ctaUrl} class="flex items-center justify-center gap-1">{props.ctaText}</Link>
    </div>
  </div>
</Container>
